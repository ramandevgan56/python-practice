class Solution:
    def sortArray(self, nums: List[int]) -> List[int]:
        n = len(nums)
        for i in range(n):
            for j in range(n-i-1):
                if nums[j] > num[j+1]:
                    #swap
                    temp = nums[j]
                    num[j] = num[j+1]
                    num[j+1] = temp

         
         return nums
         
