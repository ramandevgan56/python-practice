# 4. GLOBAL CONSTANTS / VARIABLES (Variables accessible everywhere)
TAX_RATE = 0.05
user_count = 0

# 5. FUNCTION DEFINITIONS (Modular, reusable blocks of logic)
def calculate_total(price):
    """Calculates price with tax."""
    return price + (price * TAX_RATE)

